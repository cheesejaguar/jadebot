# --- Twitch chat (IRC) ---
# Bot account login (lowercase).
TWITCH_BOT_USERNAME=your_bot_login
# IRC OAuth token, MUST include the "oauth:" prefix.
# Generate one at https://twitchtokengenerator.com (scopes: chat:read, chat:edit).
TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Twitch Helix (REST) ---
# App client ID for the same OAuth token above.
TWITCH_CLIENT_ID=your_client_id
# Numeric user IDs. Look up at https://www.streamweasels.com/tools/convert-twitch-username-to-user-id/
BROADCASTER_LOGIN=jade_infinite
BROADCASTER_USER_ID=000000000
BOT_USER_ID=000000000

# --- Web server (admin + chroma) ---
WEB_HOST=127.0.0.1
WEB_PORT=8080

# --- Storage / behavior ---
DB_PATH=logs/chat.db
# Fallback presence window (seconds) used when the Helix Get Chatters call
# is unavailable; counts anyone who chatted in the last N seconds as present.
PRESENCE_WINDOW_SEC=600
